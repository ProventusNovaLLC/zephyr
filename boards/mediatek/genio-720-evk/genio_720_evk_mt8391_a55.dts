/dts-v1/;

#include <mem.h>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/lora/sx126x.h>
#include <mediatek/mt8391.dtsi>
#include "genio_720_evk-pinctrl.dtsi"

/ {
	model = "MediaTek GENION 720 EVK (6*Cortex-A55 and 2*Cortex-A78)";
	compatible = "mediatek,mt8391-evk";

	aliases {
		trigger = &trigger_gpio;
		response = &response_gpio;
		lora0 = &lora0;
	};

	chosen {
		zephyr,console = &uart1;
		zephyr,shell-uart = &uart1;
		zephyr,sram = &dram;
		zephyr,pcie-controller = &pcie;
	};

	trigger {
		compatible = "gpio-keys";

		trigger_gpio: trigger-gpio {
			gpios = <&gpio32_63 6 GPIO_ACTIVE_LOW>;  /* GPIO 38 */
			label = "Event Trigger";
		};
    };

	response {
		compatible = "gpio-leds";

		response_gpio: response-pgio {
			gpios = <&gpio32_63 8 GPIO_ACTIVE_LOW>;  /* GPIO 40 */
			label = "Event Response";
		};
	};

	cpus {
		cpu@0 {
			status = "disabled";
		};
		cpu@100 {
			status = "disabled";
		};
		cpu@200 {
			status = "disabled";
		};
		cpu@300 {
			status = "disabled";
		};
		cpu@400 {
			status = "disabled";
		};
		cpu@600 {
			status = "disabled";
		};
		cpu@700 {
			status = "disabled";
		};
	};

	dram: memory@8000 {
		reg = <0x00008000 DT_SIZE_M(2)>;
	};

	/* Jailhouse virtual PCI (ivshmem IPC to the Linux root cell).
	 * The ECAM window and the BAR aperture are hypervisor-emulated:
	 * accesses trap to the Jailhouse device model, no real hardware
	 * backs either address. INTx pins map to the GIC SPIs granted to
	 * this cell (vpci_irq_base 576 -> INTIDs 608-611).
	 */
	pcie: pcie@20000000 {
		compatible = "pci-host-ecam-generic";
		device_type = "pci";
		reg = <0x20000000 0x100000>;
		#address-cells = <3>;
		#size-cells = <2>;
		ranges = <0x02000000 0x0 0xff000000 0xff000000 0x0 0x100000>;
		#interrupt-cells = <1>;
		interrupt-map-mask = <0x0 0x0 0x0 0x7>;
		interrupt-map = <0x0 0x0 0x0 1 &gic GIC_SPI 576 IRQ_TYPE_EDGE IRQ_DEFAULT_PRIORITY
				 0x0 0x0 0x0 2 &gic GIC_SPI 577 IRQ_TYPE_EDGE IRQ_DEFAULT_PRIORITY
				 0x0 0x0 0x0 3 &gic GIC_SPI 578 IRQ_TYPE_EDGE IRQ_DEFAULT_PRIORITY
				 0x0 0x0 0x0 4 &gic GIC_SPI 579 IRQ_TYPE_EDGE IRQ_DEFAULT_PRIORITY>;
		bus-range = <0x0 0x0>;
		status = "okay";

		ivshmem0: ivshmem@0 {
			compatible = "qemu,ivshmem";
			ivshmem-v2;
			vendor-id = <0x110A>;
			device-id = <0x4106>;
			class-rev = <0xFF000000>;      /* PCI_CLASS_OTHERS | PROTO_UNDEFINED */
			class-rev-mask = <0xFFFFFF00>;
			interrupt-parent = <&pcie>;
			interrupts = <1 2 3 4>;
			reg = <0x0 0x0 0x0 0x0 0x1>;
			status = "okay";
		};
	};
};

&uart1 {
	pinctrl-0 = <&uart1_default>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "okay";
};

/* GNSS receiver (u-blox NEO-F9P-15B) on UART2. The hub only LISTENS on this
 * port: on the ELT0359 carrier its RX pin cannot be driven (see session.md
 * 2026-10-06), so the receiver is configured over I2C from Linux. */
&uart2 {
	pinctrl-0 = <&uart2_default>;
	pinctrl-names = "default";
	current-speed = <38400>;
	status = "okay";

	gnss0: gnss {
		compatible = "u-blox,f9p";
		fix-rate = <1000>;
	};
};


&gpio32_63 {
	status = "okay";
};

&gpio64_95 {
	status = "okay";
};

&gpio96_127 {
	status = "okay";
};

&spi1 {
	pinctrl-0 = <&spi1_default>;
	pinctrl-names = "default";
	cs-gpios = <&gpio64_95 9 GPIO_ACTIVE_LOW>;   /* pad 73 */
	status = "okay";

	lora0: sx1262@0 {
		compatible = "semtech,sx1262";
		reg = <0>;
		spi-max-frequency = <2000000>;
		reset-gpios = <&gpio96_127 12 GPIO_ACTIVE_LOW>;  /* pad 108 NRESET */
		busy-gpios = <&gpio96_127 13 GPIO_ACTIVE_HIGH>;  /* pad 109 */
		dio1-gpios = <&gpio96_127 14 GPIO_ACTIVE_HIGH>;  /* pad 110 */
		dio2-tx-enable;
		dio3-tcxo-voltage = <SX126X_DIO3_TCXO_1V8>;
		tcxo-power-startup-delay-ms = <10>;
	};
};

