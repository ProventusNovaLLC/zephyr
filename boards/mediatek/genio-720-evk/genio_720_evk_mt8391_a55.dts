/dts-v1/;

#include <mem.h>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/lora/sx126x.h>
#include <mediatek/mt8391.dtsi>
#include "genio_720_evk-pinctrl.dtsi"

/ {
	model = "MediaTek GENION 720 EVK (6*Cortex-A55 and 2*Cortex-A78)";
	compatible = "mediatek,mt8391-evk";

	aliases {
		trigger = &trigger_gpio;
		response = &response_gpio;
		lora0 = &lora0;
	};

	chosen {
		zephyr,console = &uart1;
		zephyr,shell-uart = &uart1;
		zephyr,sram = &dram;
	};

	trigger {
		compatible = "gpio-keys";

		trigger_gpio: trigger-gpio {
			gpios = <&gpio32_63 6 GPIO_ACTIVE_LOW>;  /* GPIO 38 */
			label = "Event Trigger";
		};
    };

	response {
		compatible = "gpio-leds";

		response_gpio: response-pgio {
			gpios = <&gpio32_63 8 GPIO_ACTIVE_LOW>;  /* GPIO 40 */
			label = "Event Response";
		};
	};

	cpus {
		cpu@0 {
			status = "disabled";
		};
		cpu@100 {
			status = "disabled";
		};
		cpu@200 {
			status = "disabled";
		};
		cpu@300 {
			status = "disabled";
		};
		cpu@400 {
			status = "disabled";
		};
		cpu@600 {
			status = "disabled";
		};
		cpu@700 {
			status = "disabled";
		};
	};

	dram: memory@8000 {
		reg = <0x00008000 DT_SIZE_M(2)>;
	};
};

&uart1 {
	pinctrl-0 = <&uart1_default>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "okay";
};


&gpio32_63 {
	status = "okay";
};

&gpio64_95 {
	status = "okay";
};

&gpio96_127 {
	status = "okay";
};

&spi1 {
	pinctrl-0 = <&spi1_default>;
	pinctrl-names = "default";
	cs-gpios = <&gpio64_95 9 GPIO_ACTIVE_LOW>;   /* pad 73 */
	status = "okay";

	lora0: sx1262@0 {
		compatible = "semtech,sx1262";
		reg = <0>;
		spi-max-frequency = <2000000>;
		reset-gpios = <&gpio96_127 12 GPIO_ACTIVE_LOW>;  /* pad 108 NRESET */
		busy-gpios = <&gpio96_127 13 GPIO_ACTIVE_HIGH>;  /* pad 109 */
		dio1-gpios = <&gpio96_127 14 GPIO_ACTIVE_HIGH>;  /* pad 110 */
		dio2-tx-enable;
		dio3-tcxo-voltage = <SX126X_DIO3_TCXO_1V8>;
		tcxo-power-startup-delay-ms = <10>;
	};
};

