config GPIO_MT8365
	bool "MediaTek MT8365 GPIO driver"
	default y
	depends on DT_HAS_MEDIATEK_MT8365_GPIO_ENABLED
	select PINCTRL
	help
	  Enable the MediaTek MT8365 GPIO driver.

config GPIO_MT8370
	bool "MediaTek MT8370 GPIO driver"
	default y
	depends on DT_HAS_MEDIATEK_MT8370_GPIO_ENABLED
	select PINCTRL
	help
	  Enable the MediaTek MT8370 GPIO driver.

config GPIO_MT8391
	bool "MediaTek MT8391 GPIO driver"
	default y
	depends on DT_HAS_MEDIATEK_MT8391_GPIO_ENABLED
	select PINCTRL
	help
	  Enable the MediaTek MT8391 GPIO driver.
