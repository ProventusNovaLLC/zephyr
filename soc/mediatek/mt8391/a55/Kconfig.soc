	  MTK MT8391 A55

config SOC
	default "mt8391" if SOC_MT8391

config SOC_PART_NUMBER_MT8391
	bool

config SOC_PART_NUMBER
	default "mt8391" if SOC_PART_NUMBER_MT8391
